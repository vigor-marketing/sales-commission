# CVM 部署构建示例：复制为 .env.production 后执行构建
#
# VITE_API_BASE：由源码 import.meta.env 读取 → 写入 .env.production
VITE_API_BASE=/apps/sales-commission

# VITE_APP_BASE：由 vite.config.ts 读取 process.env（非 .env 文件）
# → 需在构建命令中以环境变量传入，例如：
#   VITE_APP_BASE=/apps/sales-commission/ npm run build
#
# 完整 CVM 构建流程（在 client/ 下）：
#   cp .env.example .env.production
#   VITE_APP_BASE=/apps/sales-commission/ npm run build

# VITE_WORKBENCH_ORG_PICKER_TOKEN：读取工作台组织架构人员目录所需的令牌
# （对应工作台 BFF 的 ORG_PICKER_TOKEN）。留空则「从工作台选择人员」会因 401 失败。
VITE_WORKBENCH_ORG_PICKER_TOKEN=
